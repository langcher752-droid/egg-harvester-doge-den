# Copy this file to .env and replace placeholders locally.
# Never commit .env, eggs.db, media/, or harvested message data.

# Optional LLM gateway used by vision and summarization features.
GATEWAY_BASE=https://example.invalid/v1
GATEWAY_KEY=
VISION_MODEL=global:gpt-4o-mini
SUMMARY_MODEL=global:gpt-4o-mini

# Runtime storage. Relative paths are resolved from the project directory.
DB_PATH=
MEDIA_DIR=

# Optional network proxy and request timeout.
HTTP_PROXY=
HTTP_TIMEOUT=15

# Optional integrations. Leave empty to keep them disabled.
WECHAT_WXID=
WECHAT_CODE=
WECHAT_POLL_INTERVAL=30
NAP_HTTP_URL=http://127.0.0.1:3000
NAP_CONTAINER=napcat
DOCKER_BIN=
QQ_AUTO_FILE_BYTES=20971520

# Optional media decoder overrides.
FFMPEG_BIN=
FFPROBE_BIN=
